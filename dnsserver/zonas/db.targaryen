$TTL    86400
@       IN      SOA     arya.targaryen.lan. admin.test.lan. (
                        5  ; Número de serie
                        3600        ; Actualización (Refresh)
                        1800        ; Reintento (Retry)
                        1209600     ; Caducidade (Expire)
                        86400 )     ; TTL mínimo

; Servidores de nomes
@       IN      NS      arya.targaryen.lan.

; Rexistros A dos servidores de nomes
@             IN      A       192.168.12.1
arya          IN      A       192.168.12.1